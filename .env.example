# Optional: forward every new order to a webhook (Google Sheets, Zapier, Make, n8n, Formspree...)
ORDER_WEBHOOK_URL=

# --- database -------------------------------------------------------------
# SQLite file (node:sqlite, built into Node 22+). Relative paths resolve from
# the project root. Delete the file to start over in development.
DATABASE_FILE=./data/seoul-radiance.db

# --- authentication -------------------------------------------------------
# Used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED in production - the app refuses to start without it.
SESSION_SECRET=

# --- first admin ----------------------------------------------------------
# Read only by "npm run db:seed" to create or promote the initial admin.
# Remove these after the account exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# --- email ---------------------------------------------------------------
# Leave unset (or "dev") to write messages to data/outbox/ as files instead of
# sending them. Tokens are never printed to logs.
# In production with no provider configured, mail is refused and logged
# WITHOUT the body, because the body carries a live token.
MAIL_PROVIDER=

# Absolute base URL used to build links inside emails.
APP_URL=http://localhost:3000
